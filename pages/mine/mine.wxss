.page-wrap { padding: 0 28rpx 40rpx; }

.card-title { font-size: 24rpx; font-weight: 900; display: flex; justify-content: space-between; align-items: center; margin-bottom: 14rpx; }
.link { font-size: 20rpx; font-weight: 900; color: var(--blue); }
.ai-summary { font-size: 22rpx; line-height: 1.7; color: #444; font-weight: 600; }
.ai-summary.empty { color: #AAA; font-weight: 700; }

.emotion-bar { width: 100%; height: 40rpx; border: 4rpx solid var(--black); border-radius: 20rpx; overflow: hidden; display: flex; margin: 6rpx 0 12rpx; }
.emotion-slice { height: 100%; }
.emotion-legend { display: flex; justify-content: space-between; font-size: 18rpx; font-weight: 900; }
.emotion-empty, .rank-empty { font-size: 20rpx; font-weight: 700; color: #999; line-height: 1.6; padding: 8rpx 0; }

.rank-section-title { font-size: 24rpx; font-weight: 900; margin: 24rpx 0 14rpx; }

.rank-row { display: flex; align-items: center; gap: 12rpx; background: var(--white); border: 4rpx solid var(--black); border-radius: 20rpx; padding: 12rpx 16rpx; margin-bottom: 12rpx; box-shadow: 4rpx 4rpx 0 var(--black); }
.rank-emoji { font-size: 30rpx; }
.rank-sticker { flex: 1; margin: 0; }
.rank-count { font-size: 20rpx; font-weight: 900; }
.r-up { color: var(--red); font-size: 18rpx; font-weight: 900; }
.r-down { color: var(--blue); font-size: 18rpx; font-weight: 900; }
.r-flat { color: var(--text-muted); font-size: 18rpx; font-weight: 900; }

.stats-card { background: var(--warm); margin-top: 20rpx; }
.stats-note { margin-top: 12rpx; font-size: 16rpx; font-weight: 700; color: #999; text-align: center; }
.stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.stat-mini { background: var(--white); border: 4rpx solid var(--black); border-radius: 20rpx; padding: 16rpx; text-align: center; box-shadow: 4rpx 4rpx 0 var(--black); }
.sn { font-size: 40rpx; font-weight: 900; display: block; }
.sl { font-size: 18rpx; font-weight: 900; color: #777; }
