.page-wrap { padding: 0 28rpx 40rpx; }

/* 语言切换卡片 */
.lang-card { background: #FFFFFF; }
.lang-tag { font-size: 18rpx; font-weight: 900; background: var(--warm); padding: 4rpx 10rpx; border: 2rpx solid var(--black); border-radius: 12rpx; }
.lang-selector-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 8rpx; }
.lang-opt-btn { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 16rpx 10rpx; border: 3rpx solid var(--black); border-radius: 18rpx; background: var(--warm); box-shadow: 3rpx 3rpx 0 var(--black); }
.lang-opt-btn.active { background: var(--yellow); transform: translateY(-2rpx); box-shadow: 4rpx 4rpx 0 var(--black); }
.lang-opt-name { font-size: 22rpx; font-weight: 900; color: #1A1A1A; margin-bottom: 2rpx; }
.lang-opt-sub { font-size: 16rpx; font-weight: 700; color: #777; }

.card-title { font-size: 24rpx; font-weight: 900; display: flex; justify-content: space-between; align-items: center; margin-bottom: 14rpx; }
.link { font-size: 20rpx; font-weight: 900; color: var(--blue); }

/* 生图就绪状态条 */
.ai-banner { display: flex; align-items: flex-start; gap: 14rpx; padding: 14rpx 16rpx; border: 3rpx solid var(--black); border-radius: 16rpx; margin-bottom: 18rpx; box-shadow: 3rpx 3rpx 0 var(--black); }
.banner-tip { background: #FFF8E1; }
.banner-ok { background: #E8F5E9; }
.banner-icon { font-size: 32rpx; line-height: 1.2; }
.banner-content { flex: 1; display: flex; flex-direction: column; }
.banner-title { font-size: 20rpx; font-weight: 900; color: #1A1A1A; margin-bottom: 4rpx; }
.banner-desc { font-size: 16rpx; color: #555; line-height: 1.4; }

/* 分类分组标题 */
.provider-group-title { display: flex; align-items: center; justify-content: space-between; font-size: 20rpx; font-weight: 900; margin-bottom: 10rpx; color: #222; }
.text-group-title { margin-top: 14rpx; }
.group-tag-rec { font-size: 16rpx; background: var(--yellow); padding: 4rpx 10rpx; border: 2rpx solid var(--black); border-radius: 12rpx; font-weight: 900; }
.group-tag-text { font-size: 16rpx; color: #888; font-weight: 700; }

.provider-chips { display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: 14rpx; }
.provider-chip { display: flex; align-items: center; gap: 6rpx; padding: 8rpx 16rpx; border: 3rpx solid var(--black); border-radius: 24rpx; font-size: 18rpx; font-weight: 900; background: var(--white); }
.provider-chip.active { background: var(--yellow); box-shadow: 3rpx 3rpx 0 var(--black); }
.img-chip { border-color: #1A1A1A; }
.chip-badge { font-size: 14rpx; background: var(--red); color: #FFF; padding: 2rpx 8rpx; border-radius: 10rpx; font-weight: 900; }

/* 当前选中服务商信息盒子 */
.current-provider-box { background: var(--warm); border: 3rpx solid var(--black); border-radius: 16rpx; padding: 12rpx 16rpx; margin-bottom: 14rpx; }
.cp-header { display: flex; align-items: center; gap: 10rpx; margin-bottom: 6rpx; }
.cp-name { font-size: 22rpx; font-weight: 900; color: #1A1A1A; }
.cp-tag { font-size: 16rpx; padding: 2rpx 8rpx; border-radius: 8rpx; font-weight: 900; }
.cp-tag-image { background: #C8E6C9; color: #2E7D32; border: 2rpx solid #2E7D32; }
.cp-tag-text { background: #E0E0E0; color: #616161; border: 2rpx solid #616161; }
.cp-copy-link { margin-left: auto; font-size: 18rpx; color: var(--blue); font-weight: 900; }
.cp-desc { font-size: 17rpx; color: #555; line-height: 1.4; }

.ai-key-input { width: 100%; height: 76rpx; border: 4rpx solid var(--black); border-radius: 16rpx; background: var(--white); padding: 0 18rpx; font-size: 22rpx; margin-bottom: 14rpx; }
.ai-setting-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.ai-setting-label { width: 130rpx; font-size: 20rpx; font-weight: 900; color: #666; }
.ai-model-input { flex: 1; height: 64rpx; border: 3rpx solid var(--black); border-radius: 14rpx; padding: 0 14rpx; font-size: 20rpx; background: var(--white); }
.model-chips { display: flex; flex-wrap: wrap; gap: 8rpx; margin: 0 0 14rpx 142rpx; }
.model-chip { padding: 6rpx 14rpx; border: 3rpx solid var(--black); border-radius: 22rpx; font-size: 16rpx; font-weight: 900; background: var(--white); }
.model-chip.active { background: var(--yellow); box-shadow: 2rpx 2rpx 0 var(--black); }
.ai-btn-row { display: flex; gap: 12rpx; margin-top: 6rpx; }
.ai-btn-row button { flex: 1; font-size: 20rpx; padding: 12rpx 0; }
.test-btn { width: 100%; margin-top: 12rpx; font-size: 20rpx; padding: 12rpx 0; }
.ai-status { margin-top: 12rpx; font-size: 18rpx; font-weight: 900; color: var(--blue); line-height: 1.5; }
.ai-note { margin-top: 8rpx; font-size: 16rpx; color: #999; line-height: 1.5; }
.text-only-note { color: #E65100; background: #FFF3E0; padding: 8rpx 12rpx; border-radius: 10rpx; border: 2rpx dashed #FFB74D; }

.usage-label { font-size: 20rpx; font-weight: 900; margin-bottom: 8rpx; }
.prog-bg { height: 16rpx; background: #E8E8E8; border: 2rpx solid var(--black); border-radius: 8rpx; overflow: hidden; }
.prog-fill { height: 100%; background: var(--yellow); }
.usage-row { display: flex; justify-content: space-between; font-size: 16rpx; font-weight: 900; color: #888; margin: 8rpx 0 14rpx; }
.api-row { display: flex; justify-content: space-between; align-items: center; background: var(--warm); border: 3rpx solid var(--black); border-radius: 14rpx; padding: 10rpx 16rpx; font-size: 20rpx; margin-bottom: 12rpx; font-family: "SF Mono", Menlo, monospace; }
.danger { color: var(--red); font-weight: 900; }
.new-key-btn { width: 100%; font-size: 20rpx; color: var(--blue); padding: 12rpx 0; }

.dev-tag { display: inline-block; font-size: 18rpx; font-weight: 900; color: var(--blue); border: 2rpx solid var(--blue); border-radius: 10rpx; padding: 2rpx 10rpx; margin-bottom: 12rpx; }

.asr-status { margin-top: 10rpx; padding: 10rpx 14rpx; border: 2rpx dashed #CCC; border-radius: 12rpx; font-size: 18rpx; font-weight: 900; color: #999; }
.asr-status.asr-ok { color: #1B7F4B; border-color: #1B7F4B; background: #F2FBF5; }

.stats-card { background: var(--warm); }
.stats-note { margin-top: 12rpx; font-size: 16rpx; font-weight: 700; color: #999; text-align: center; }
.stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.stat-mini { background: var(--white); border: 4rpx solid var(--black); border-radius: 20rpx; padding: 16rpx; text-align: center; box-shadow: 4rpx 4rpx 0 var(--black); }
.sn { font-size: 40rpx; font-weight: 900; display: block; }
.sl { font-size: 18rpx; font-weight: 900; color: #777; }

.set-row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; border-bottom: 3rpx dashed var(--black); font-size: 24rpx; font-weight: 900; }
.set-row:last-child { border-bottom: none; }
.set-arrow { color: #AAA; font-size: 28rpx; }
